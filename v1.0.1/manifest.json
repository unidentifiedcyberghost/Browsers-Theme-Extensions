{
  "manifest_version": 3,
  "name": "CyberSecurity Theme v1.0.1",
  "version": "1.0.1",
  "description": "9 animated browser themes with a Conky-inspired HUD, world clocks, saved bookmarks, and opt-in public IP lookup. By PinoyUnknown.",
  "author": "PinoyUnknown | unidentifiedcyberghost",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CyberSecurity Theme v1.0.1"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/themes.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "bookmarks",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://open.er-api.com/*"
  ],
  "optional_host_permissions": [
    "https://api.ipify.org/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared/themes.js",
        "newtab/*",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}